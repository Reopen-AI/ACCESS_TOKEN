{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "access-token",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "build": { "command": "node build-worker.mjs" },
  "vars": {
    "API_BASE_URL": "https://tm.goldoak.cn",
    // The editable form defaults to test. Only listed devices can receive public tokens.
    // Each device must already be bound to an account in the translation backend.
    "PUBLIC_DEVICE_ID": "test",
    "PUBLIC_DEVICE_IDS": "[\"test\"]",
    "APP_VERSION": "V0.2.8",
    "DEVICE_VERSION": "1.3",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFn4bwZe40_lYtGV",
    // Optional. Set to the final HTTPS origin, with no trailing slash.
    "PUBLIC_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "173001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SITE_RATE_LIMITER",
      "namespace_id": "173002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Do not collect request logs containing credentials. Never console.log tokens.
  "observability": { "enabled": false }
}
